{
  "name": "entregable-2-playwright-ts",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "playwright install",
    "test": "npx playwright test",
    "test:ci": "playwright test --reporter=line",
    "mock:up": "docker compose up -d wiremock",
    "mock:down": "docker compose down --remove-orphans",
    "test:headed": "npx playwright test --headed",
    "test:mock": "cross-env AUTH_MODE=mock npx playwright test",
    "test:mock:win": "set AUTH_MODE=mock&& npx playwright test",
    "test:mock:ps": "powershell -NoProfile -Command \"$env:AUTH_MODE='mock'; npx playwright test; Remove-Item Env:AUTH_MODE\"",
    "docker:build": "docker compose build",
    "docker:test:real": "docker compose run --rm real",
    "docker:test:mock": "docker compose run --rm mock",
    "allure:generate": "allure generate ./reports/allure-results --clean -o ./reports/allure-report",
    "allure:open": "allure open ./reports/allure-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^2.15.1",
    "cross-env": "^7.0.3",
    "dotenv": "^16.6.1",
    "playwright": "^1.56.1",
    "testcontainers": "^10.28.0",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  }
}
